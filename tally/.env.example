# ─────────────────────────────────────────────────────────────────────────
# Tally — v1 is local-first. There is no backend, so every variable here is
# optional and the app runs correctly with this file absent entirely.
#
# IMPORTANT: anything prefixed NEXT_PUBLIC_ is embedded in the JavaScript
# bundle and is readable by anyone who opens DevTools. There is no such thing
# as a secret in a client-side app. Never put a credential here.
# ─────────────────────────────────────────────────────────────────────────

# Display name, used in the page title and the sidebar wordmark.
NEXT_PUBLIC_APP_NAME="Tally"

# IndexedDB database name. Change it to start from a clean slate during
# development without touching your real data.
NEXT_PUBLIC_DB_NAME="tally"


# ─────────────────────────────────────────────────────────────────────────
# v2 — accounts and sync. Unused in v1, listed so the shape is documented.
# ─────────────────────────────────────────────────────────────────────────

# Supabase project URL. Public.
# NEXT_PUBLIC_SUPABASE_URL=

# Supabase ANON key. Public by design; safe only because Row Level Security
# is enabled on every table. Verify that before shipping v2.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WARNING: never add SUPABASE_SERVICE_ROLE_KEY to this project. It bypasses
# Row Level Security entirely and belongs only in server-side environments.

# Privacy-friendly analytics (Plausible). Leave blank and nothing is sent.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_URL=
